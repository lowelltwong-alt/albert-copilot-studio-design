          {
            "oauth2": [
              "write"
            ]
          }
        ],
        "parameters": [
          {
            "in": "body",
            "name": "request",
            "required": true,
            "schema": {
              "$ref": "#/definitions/StartJobRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted service result (an asynchronous operation returns a job handle).",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "400": {
            "description": "Malformed request",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Missing or invalid authentication",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "Access or approval denied",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Not found in caller scope",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Stale state, idempotency mismatch or other conflict",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "Invalid domain input or quality policy unresolved",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "429": {
            "description": "Capacity or budget limit",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "503": {
            "description": "Temporary service unavailability; reconcile unknown writes",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
