  S["SOURCE<br/>Raw file + revision"]:::work
  SP["SPAN<br/>Exact anchors + qualifiers"]:::work
  EX["ITEM<br/>Distinct exhibit / attachment"]:::work
  C1["CLAIM A<br/>Attributed meaning + time"]:::work
