{
  "case_id": "LANTERN",
  "witness": "MINA",
  "revision": "R01",
  "identity_mode": "manual_revision",
  "sources": [
    "S01",
    "S02",
    "S03"
  ],
  "spans": [
    {
      "id": "SP01",
      "source": "S01",
      "anchor": "S01:P01",
      "text": "I arrived at Lantern Hall at about 1:50 p.m. I was helping set out chairs. I did not make a note of the time as I arrived."
    },
    {
      "id": "SP02",
      "source": "S01",
      "anchor": "S01:P02",
      "text": "A tall folding screen stood between the chair area and the east doorway. From the chair area I could not see the floor immediately inside that doorway."
    },
    {
      "id": "SP03",
      "source": "S01",
      "anchor": "S01:P03",
      "text": "I heard a clatter while I was moving my own small cart near the chairs. I did not see a cart or a person hit a speaker."
    },
    {
      "id": "SP04",
      "source": "S01",
      "anchor": "S01:P04",
      "text": "After the clatter, I walked around the screen and saw Owen beside the east doorway and a speaker on the floor. I cannot say from that observation how the speaker got there."
    },
    {
      "id": "SP05",
      "source": "S01",
      "anchor": "S01:P05",
      "text": "My best estimate is that the clatter was around 2:10 p.m. I looked at the wall clock after I had walked around the screen, not at the instant of the sound. I remember it being a little after two; I cannot give an exact minute."
    },
    {
      "id": "SP06",
      "source": "S01",
      "anchor": "S01:P06",
      "text": "I had been at a meeting scheduled to finish at 2:00 p.m., but I left it before it finished. I did not check when the meeting actually ended."
    },
    {
      "id": "SP07",
      "source": "S02",
      "anchor": "S02:P01",
      "text": "I reached the east doorway at about 2:15 p.m. The speaker was already on the floor when I arrived. I did not see it fall."
    },
    {
      "id": "SP08",
      "source": "S02",
      "anchor": "S02:P02",
      "text": "I remember checking my phone shortly before I reached the door, but I did not save a screenshot or make a note of the exact time."
    },
    {
      "id": "SP09",
      "source": "S03",
      "anchor": "S03:A01",
      "text": "Delivery record: Lantern Hall; two speakers; recorded delivery time 2:00 p.m.; condition box marked \"unchecked\". A signature field reads \"Lee\". The record does not identify Mina as a signer or witness to delivery."
    },
    {
      "id": "SP10",
      "source": "S03",
      "anchor": "S03:A02",
      "text": "The packet supplies no statement by Lee explaining the signature, inspection, or delivery-time entry. The document is available for discussion as a record; no witness in this packet authenticates it."
    },
    {
      "id": "SP11",
      "source": "S03",
      "anchor": "S03:B01",
      "text": "Printed meeting schedule: Lantern Hall planning meeting, 1:30 p.m. to 2:00 p.m."
    },
    {
      "id": "SP12",
      "source": "S03",
      "anchor": "S03:B02",
      "text": "This is a schedule, not a record of the meeting's actual finishing time."
    }
  ],
  "claims": [
    {
      "id": "CL01",
      "span": "SP01",
      "text": "Mina says she arrived about 1:50 and did not note arrival time.",
      "actor": "Mina",
      "lane": "witness_observed"
    },
    {
      "id": "CL02",
      "span": "SP02",
      "text": "Mina says the screen blocked her view of the floor inside the east doorway.",
      "actor": "Mina",
      "lane": "witness_observed"
    },
    {
      "id": "CL03",
      "span": "SP03",
      "text": "Mina says she heard a clatter while moving her own small cart near chairs.",
      "actor": "Mina",
      "lane": "witness_observed"
    },
    {
      "id": "CL04",
      "span": "SP03",
      "text": "Mina says she did not see a cart or person hit a speaker.",
      "actor": "Mina",
      "lane": "witness_observed"
    },
    {
      "id": "CL05",
      "span": "SP04",
      "text": "Mina says she later walked around the screen and saw Owen near the doorway and a speaker on the floor.",
      "actor": "Mina",
      "lane": "witness_observed"
    },
    {
      "id": "CL06",
      "span": "SP04",
      "text": "Mina says that later observation does not tell her how the speaker got there.",
      "actor": "Mina",
      "lane": "witness_observed"
    },
    {
      "id": "CL07",
      "span": "SP05",
      "text": "Mina estimates the clatter around 2:10, checked the clock afterward and cannot give an exact minute.",
      "actor": "Mina",
      "lane": "witness_observed"
    },
    {
      "id": "CL08",
      "span": "SP06",
      "text": "Mina says the meeting was scheduled to finish at 2:00; she left before it finished and did not check its actual end.",
      "actor": "Mina",
      "lane": "witness_observed"
    },
    {
      "id": "CL09",
      "span": "SP07",
      "text": "Owen says he arrived about 2:15 and the speaker was already on the floor; he did not see it fall.",
      "actor": "Owen",
      "lane": "attributed_disputed"
    },
    {
      "id": "CL10",
      "span": "SP08",
      "text": "Owen says he checked his phone before arriving but saved no screenshot or exact-time note.",
      "actor": "Owen",
      "lane": "attributed_disputed"
    },
    {
      "id": "CL11",
      "span": "SP09",
      "text": "Attachment A records two speakers, 2:00 delivery time, condition unchecked and a Lee signature field; it does not identify Mina as signer or delivery witness.",
      "actor": "Attachment A",
      "lane": "witness_later_learned"
    },
    {
      "id": "CL12",
      "span": "SP10",
      "text": "The supplied packet has no Lee statement explaining the entry and provides no authentication by a witness.",
      "actor": "Packet scope",
      "lane": "witness_later_learned"
    },
    {
      "id": "CL13",
      "span": "SP11",
      "text": "Schedule insert B prints a 1:30 to 2:00 meeting slot.",
      "actor": "Schedule insert B",
      "lane": "witness_later_learned"
    },
    {
      "id": "CL14",
      "span": "SP12",
      "text": "Schedule insert B is a plan, not evidence of the actual finishing time.",
      "actor": "Schedule insert B",
      "lane": "witness_later_learned"
    }
  ],
