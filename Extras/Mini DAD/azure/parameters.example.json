{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "managedEnvironmentName": { "value": "<environment>" },
    "containerAppName": { "value": "digital-assets-mcp" },
    "image": { "value": "<registry>.azurecr.io/digital-assets-mcp:1.0.0" },
    "storageAccountName": { "value": "<storage-account>" },
    "storageAccountKey": { "value": "<inject-from-key-vault-at-deploy-time>" },
    "fileShareName": { "value": "digital-assets-state" },
    "allowedHost": { "value": "assets.example.com" },
    "allowedOrigin": { "value": "https://copilotstudio.microsoft.com" },
    "readerApiKey": { "value": "<inject-a-32-character-secret>" },
    "intakeApiKey": { "value": "<inject-a-distinct-32-character-secret>" }
  }
}
