{
  "tools": [
    {
      "name": "StartJob",
      "description": "Start a bounded approved job; returns its handle without waiting for generation.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commandAuthorizationToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "caseId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "caseRevision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sourceRevision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sourceSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "graphRevision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "graphSnapshotSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "witnessViewRevision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "witnessViewSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "policyRevision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "accessPolicySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "caseId",
              "caseRevision",
              "sourceRevision",
              "sourceSha256",
              "graphRevision",
              "graphSnapshotSha256",
              "witnessViewRevision",
              "witnessViewSha256",
              "policyRevision",
              "accessPolicySha256"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "intake",
              "source_review",
              "chunk",
              "graph_profile",
              "witness_view",
              "packet",
              "script",
              "consistency",
              "export",
              "study"
            ]
          },
          "inputArtifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 50
          },
          "movementApprovalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "budgetApprovalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "commandAuthorizationToken",
          "binding",
          "kind",
          "inputArtifactIds",
          "movementApprovalId",
          "budgetApprovalId"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "x-albert-api-operation": "StartJob",
      "x-albert-required-scope": "write"
    },
