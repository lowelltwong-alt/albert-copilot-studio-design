{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "caseRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "graphRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "graphSnapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "witnessViewRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "witnessViewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "accessPolicySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "caseId",
        "caseRevision",
        "sourceRevision",
        "sourceSha256",
        "graphRevision",
        "graphSnapshotSha256",
        "witnessViewRevision",
        "witnessViewSha256",
        "policyRevision",
        "accessPolicySha256"
      ]
    },
    "StartJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandAuthorizationToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "kind": {
          "type": "string",
          "enum": [
            "intake",
            "source_review",
            "chunk",
            "graph_profile",
            "witness_view",
            "packet",
            "script",
            "consistency",
            "export",
            "study"
          ]
        },
        "inputArtifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 50
        },
        "movementApprovalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "budgetApprovalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "commandAuthorizationToken",
        "binding",
        "kind",
        "inputArtifactIds",
        "movementApprovalId",
        "budgetApprovalId"
      ]
    },
    "GetJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "canonicalRequestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "readOperationId",
        "canonicalRequestDigest",
        "caseId",
        "jobId"
      ]
    },
    "CancelJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandAuthorizationToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedStateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "commandAuthorizationToken",
        "binding",
        "jobId",
        "expectedStateVersion",
        "reason"
      ]
    },
    "LookupOperationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "canonicalRequestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "expectedRequestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "readOperationId",
        "canonicalRequestDigest",
        "caseId",
        "operationId",
        "expectedRequestDigest"
      ]
    },
    "ReadGraphRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "canonicalRequestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "viewGrantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "queryKind": {
          "type": "string",
          "enum": [
            "witness_knowledge_at_time",
            "conflicts_and_corroboration",
            "issue_proof_matrix",
            "exhibit_foundation",
            "impeachment_rehabilitation",
            "direct_cross_goals",
            "opened_door_risks",
            "artifact_dependencies"
          ]
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "atTime": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "readOperationId",
        "canonicalRequestDigest",
        "binding",
        "viewGrantId",
        "queryKind",
        "subjectId",
        "atTime",
        "depth",
        "limit",
        "cursor"
      ]
    },
    "ReadArtifactRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "canonicalRequestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "viewGrantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "readOperationId",
        "canonicalRequestDigest",
        "binding",
        "artifactId",
        "viewGrantId",
        "sectionId"
      ]
    },
    "SaveCandidateRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandAuthorizationToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "seriesId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidateKind": {
          "type": "string",
          "enum": [
            "source_review_proposal",
            "case_profile_proposal",
            "witness_settings_proposal",
            "witness_packet",
            "podcast_script",
            "coach_annex"
          ]
        },
        "parentArtifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "grantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidateText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "sourceAnchorIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 500
        },
        "targetFindingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 100
        }
      },
      "required": [
        "commandAuthorizationToken",
        "binding",
        "seriesId",
        "candidateKind",
        "parentArtifactId",
        "assignmentId",
        "grantId",
        "candidateText",
        "sourceAnchorIds",
        "targetFindingIds"
      ]
    },
    "RequestEvaluationRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandAuthorizationToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "seriesId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "witnessGrantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "commandAuthorizationToken",
        "binding",
        "artifactId",
        "seriesId",
        "witnessGrantId"
      ]
    },
    "ReviewSubject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "data_movement_approval",
            "layout_exhibit_review",
            "case_witness_profile",
            "quality_rework_plan",
            "artifact_pair",
            "study_custody",
            "vendor_handoff"
          ]
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subjectDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "subjectId",
        "subjectDigest",
        "expectedVersion"
      ]
    },
    "RecordHumanDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandAuthorizationToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "reviewSubject": {
          "$ref": "#/$defs/ReviewSubject"
        },
        "reviewScreen": {
          "type": "string",
          "enum": [
            "H01",
            "H02",
            "H03",
            "H04",
            "H05",
            "H06",
            "H07"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject",
            "request_changes",
            "revoke"
          ]
        },
        "reviewNonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "commandAuthorizationToken",
        "binding",
        "reviewSubject",
        "reviewScreen",
        "decision",
        "reviewNonce",
        "reason"
      ]
    },
    "Job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting_human",
            "retry_wait",
            "reconciling",
            "needs_rework",
            "review_ready_pending_human",
            "succeeded",
            "failed",
            "cancel_requested",
            "cancelled",
            "stale",
            "budget_exhausted",
            "unresolved_not_parity"
          ]
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "pollAfterSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "artifactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "jobId",
        "operationId",
        "caseId",
        "state",
        "stateVersion",
        "pollAfterSeconds",
        "binding",
        "artifactIds",
        "error",
        "correlationId"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "correlationId",
        "retryable"
      ]
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "completed",
            "rejected",
            "not_found_pending_commit"
          ]
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stateVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "resultId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "resultKind": {
          "type": "string",
          "enum": [
            "job",
            "artifact",
            "decision",
            "none"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "operationId",
        "requestDigest",
        "status",
        "state",
        "stateVersion",
        "resultId",
        "resultKind",
        "error",
        "correlationId"
      ]
    },
    "GraphPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "graphSnapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "accessPolicySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "records": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recordId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "enum": [
                  "claim",
                  "assertion",
                  "inference",
                  "conflict",
                  "gap",
                  "source_span",
                  "exhibit",
                  "rule"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "sourceAnchorIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "maxItems": 50
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "recordId",
              "kind",
              "text",
              "sourceAnchorIds",
              "attribution"
            ]
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "binding",
        "graphSnapshotSha256",
        "accessPolicySha256",
        "records",
        "nextCursor"
      ]
    },
    "ArtifactSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "sectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "nextSectionId": {
          "type": "string",
          "maxLength": 200
        },
        "eligibleForExport": {
          "type": "boolean"
        }
      },
      "required": [
        "artifactId",
        "artifactDigest",
        "binding",
        "sectionId",
        "text",
        "nextSectionId",
        "eligibleForExport"
      ]
    },
    "CandidateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seriesId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revisionNumber": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "draft"
          ]
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        }
      },
      "required": [
        "artifactId",
        "artifactDigest",
        "seriesId",
        "revisionNumber",
        "status",
        "binding"
      ]
    },
    "DecisionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewSubject": {
          "$ref": "#/$defs/ReviewSubject"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "reject",
            "request_changes",
            "revoke"
          ]
        },
        "exportJobId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decisionId",
        "reviewSubject",
        "decision",
        "exportJobId"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewSubject": {
                "properties": {
                  "kind": {
                    "const": "artifact_pair"
                  }
                }
              },
              "decision": {
                "const": "approve"
              }
            }
          },
          "then": {
            "properties": {
              "exportJobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "else": {
            "properties": {
              "exportJobId": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
